# Переименовать в .env.local - env-файл для локального деплоя
# .env для деплоя на сервер - инструкция ниже + DEPLOY.md

#settings.py
SECRET_KEY=secret_key
DEBUG=debug(True/False)

# Какой .env использовать
# При локальном ЗАПУСКЕ:
ENV=local
LOCAL_DB=local_bulletin
# При локальном и серверном деплое переменные выше НЕ!!! пишутся

# DATABASE настройки
POSTGRES_DB=название_БД
POSTGRES_USER=пользователь_БД
POSTGRES_PASSWORD=пароль_БД
POSTGRES_HOST=db
PORT=порт_БД

# Redis URLs для Celery
CELERY_BROKER_URL=redis:...
CELERY_BACKEND=redis:...

# Публичный IP сервера. Оставляем так
SERVER_PUB_IP=130.193.57.240

# данные для почтовой рассылки сброса пароля через Яндекс
YANDEX_EMAIL_HOST=хост_от_Яндекс_почты
YANDEX_EMAIL_PORT=порт_от_Яндекс_почты
YANDEX_EMAIL_USE_TLS=использование_TLS
YANDEX_EMAIL_USE_SSL=использование_SSL
YANDEX_EMAIL_HOST_USER=почта_с_которой_отправляется_писмо
YANDEX_EMAIL_HOST_PASSWORD=хост_пароль_от_Яндекс_почты

